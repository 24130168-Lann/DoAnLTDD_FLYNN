<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="16dp" android:layout_marginEnd="16dp" android:background="@drawable/bg_streak_card" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp">
        <TextView android:id="@+id/tvStreakCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10" android:textColor="@color/flynn_brown" android:textSize="48sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ngày liên tiếp" android:textColor="@color/flynn_text" android:textSize="14sp"/>
            <TextView android:id="@+id/tvLongestStreak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chuỗi dài nhất: 22 ngày" android:textColor="@color/flynn_brown_text" android:textSize="13sp"/>
        </LinearLayout>
    </LinearLayout>
    <!--  7 ngày trong tuần, chia đều chiều ngang  -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
        <FrameLayout android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1">
            <TextView android:id="@+id/dayT2" android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center" android:background="@drawable/bg_day_on" android:gravity="center" android:text="T2" android:textColor="@android:color/white" android:textSize="12sp" android:textStyle="bold"/>
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1">
            <TextView android:id="@+id/dayT3" android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center" android:background="@drawable/bg_day_on" android:gravity="center" android:text="T3" android:textColor="@android:color/white" android:textSize="12sp" android:textStyle="bold"/>
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1">
            <TextView android:id="@+id/dayT4" android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center" android:background="@drawable/bg_day_on" android:gravity="center" android:text="T4" android:textColor="@android:color/white" android:textSize="12sp" android:textStyle="bold"/>
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1">
            <TextView android:id="@+id/dayT5" android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center" android:background="@drawable/bg_day_on" android:gravity="center" android:text="T5" android:textColor="@android:color/white" android:textSize="12sp" android:textStyle="bold"/>
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1">
            <TextView android:id="@+id/dayT6" android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center" android:background="@drawable/bg_day_off" android:gravity="center" android:text="T6" android:textColor="@color/flynn_day_off_text" android:textSize="12sp" android:textStyle="bold"/>
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1">
            <TextView android:id="@+id/dayT7" android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center" android:background="@drawable/bg_day_off" android:gravity="center" android:text="T7" android:textColor="@color/flynn_day_off_text" android:textSize="12sp" android:textStyle="bold"/>
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1">
            <TextView android:id="@+id/dayCN" android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center" android:background="@drawable/bg_day_off" android:gravity="center" android:text="CN" android:textColor="@color/flynn_day_off_text" android:textSize="12sp" android:textStyle="bold"/>
        </FrameLayout>
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnWriteDiary" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" android:text="Ghi nhật ký để giữ chuỗi" android:textAllCaps="false" android:textColor="@android:color/white" android:textSize="16sp" android:textStyle="bold" app:backgroundTint="@color/flynn_brown" app:cornerRadius="10dp"/>
</LinearLayout>