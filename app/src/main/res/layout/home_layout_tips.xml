            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_marginEnd="8dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="2" android:text="Cách nhận biết cây thiếu nước" android:textColor="@color/flynn_text" android:textSize="14sp" android:textStyle="bold"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="6dp" android:layout_marginEnd="16dp" android:layout_marginBottom="6dp" app:cardBackgroundColor="@android:color/white" app:cardCornerRadius="10dp" app:cardElevation="3dp" app:strokeWidth="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="6dp">
            <com.google.android.material.imageview.ShapeableImageView android:layout_width="100dp" android:layout_height="70dp" android:contentDescription="Phòng sâu bệnh cho xà lách thủy canh" android:scaleType="centerCrop" android:src="@drawable/img_tip_1" app:shapeAppearanceOverlay="@style/Flynn.Rounded8"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_marginEnd="8dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="2" android:text="Phòng sâu bệnh cho xà lách thủy canh" android:textColor="@color/flynn_text" android:textSize="14sp" android:textStyle="bold"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
