package com.example.doanltdd_flynn.adapter;

import android.content.res.ColorStateList;
import android.util.TypedValue;
import android.view.LayoutInflater;
import android.view.View;
import android.view.ViewGroup;
import android.widget.ImageButton;
import android.widget.PopupMenu;
import android.widget.TextView;

import androidx.annotation.NonNull;
import androidx.core.content.ContextCompat;
import androidx.recyclerview.widget.RecyclerView;

import com.example.doanltdd_flynn.R;
import com.example.doanltdd_flynn.model.CareLog;
import com.example.doanltdd_flynn.model.CareType;
import com.example.doanltdd_flynn.utils.ChuoiUtil;
import com.example.doanltdd_flynn.utils.UiUtil;
import com.google.android.material.chip.Chip;
import com.google.android.material.chip.ChipGroup;

import java.util.ArrayList;
import java.util.List;

public class CareLogAdapter extends RecyclerView.Adapter<CareLogAdapter.ViewHolder> {

    public interface Listener {
        void onEdit(CareLog log);

        void onDelete(CareLog log);
    }

    private List<CareLog> careLogs = new ArrayList<>();
    private final Listener listener;

    public CareLogAdapter(Listener listener) {
        this.listener = listener;
    }

    public void submitList(List<CareLog> logs) {
        this.careLogs = logs == null
                ? new ArrayList<>()
                : logs;

        notifyDataSetChanged();
    }

    @NonNull
    @Override
    public ViewHolder onCreateViewHolder(
            @NonNull ViewGroup parent,
            int viewType
    ) {

        View v = LayoutInflater.from(parent.getContext())
                .inflate(R.layout.item_care_log, parent, false);

        return new ViewHolder(v);
    }

    @Override
    public void onBindViewHolder(
            @NonNull ViewHolder h,
            int position
    ) {

        CareLog log = careLogs.get(position);

        h.tvDate.setText(
                ChuoiUtil.display(log.getCareDate())
        );

        // Hiển thị tất cả hoạt động chăm sóc
        h.chipCareTypes.removeAllViews();

        List<CareType> careTypes = log.getCareTypes();

        if (careTypes != null) {

            for (CareType type : careTypes) {

                if (type == null) {
                    continue;
                }

                Chip chip = new Chip(h.itemView.getContext());

                chip.setText(UiUtil.careTypeLabel(type));

                chip.setCheckable(false);
                chip.setClickable(false);
                chip.setFocusable(false);

                chip.setEnsureMinTouchTargetSize(false);

                chip.setChipBackgroundColor(
                        ColorStateList.valueOf(
                                ContextCompat.getColor(
                                        h.itemView.getContext(),
                                        R.color.flynn_green_light
                                )
                        )
                );

                chip.setTextColor(
                        ContextCompat.getColor(
                                h.itemView.getContext(),
                                R.color.flynn_green_dark
                        )
                );

                chip.setTextSize(
                        TypedValue.COMPLEX_UNIT_SP,
                        11
                );

                chip.setChipCornerRadius(dp(h.itemView, 8));

                chip.setChipStrokeWidth(0);

                h.chipCareTypes.addView(chip);
            }
        }

        h.tvNote.setText(log.getNote());

        // Menu Sửa / Xóa
        h.btnMore.setOnClickListener(anchor -> {

            PopupMenu menu = new PopupMenu(
                    anchor.getContext(),
                    anchor
            );

            menu.getMenuInflater().inflate(
                    R.menu.menu_care_log_item,
                    menu.getMenu()
            );

            menu.setOnMenuItemClickListener(item -> {

                if (item.getItemId() == R.id.action_edit) {

                    listener.onEdit(log);

                    return true;

                } else if (item.getItemId() == R.id.action_delete) {

                    listener.onDelete(log);

                    return true;
                }

                return false;
            });

            menu.show();
        });
    }

    private float dp(View view, int value) {
        return TypedValue.applyDimension(
                TypedValue.COMPLEX_UNIT_DIP,
                value,
                view.getResources().getDisplayMetrics()
        );
    }

    @Override
    public int getItemCount() {
        return careLogs.size();
    }

    static class ViewHolder extends RecyclerView.ViewHolder {

        final TextView tvDate;
        final ChipGroup chipCareTypes;
        final TextView tvNote;
        final ImageButton btnMore;

        ViewHolder(@NonNull View itemView) {
            super(itemView);

            tvDate = itemView.findViewById(R.id.tvDate);

            chipCareTypes = itemView.findViewById(
                    R.id.chipCareTypes
            );

            tvNote = itemView.findViewById(R.id.tvNote);

            btnMore = itemView.findViewById(R.id.btnMore);
        }
    }
}
